# Sablon a környezeti fájlokhoz. Ez az EGYETLEN .env* fájl, ami a gitbe kerül.
#
# Felépítés:
#   .env       -> csak a kapcsoló: APP_ENV=dev  vagy  APP_ENV=prod
#   .env.dev   -> fejlesztői beállítások (Mailpit, localhost)
#   .env.prod  -> éles beállítások (Gmail, valódi domain)
#
# Új gépen:
#   echo APP_ENV=dev > .env
#   cp .env.example .env.dev    (és cp .env.example .env.prod), majd töltsd ki őket.
# Jelszó generálás:  openssl rand -hex 24      JWT kulcs:  openssl rand -base64 48

# --- Adatbázis (PostgreSQL) ---
# A jelszót a Postgres csak az adatbázis LÉTREHOZÁSAKOR olvassa be!
POSTGRES_DB=cinegrade
POSTGRES_USER=cinegrade
POSTGRES_PASSWORD=change-me

# --- JWT aláíró kulcs (base64, min. 32 bájt) ---
JWT_SECRET=change-me

# --- E-mail ---
# Dev: Mailpit fogja el a leveleket (http://localhost:8025), nem kell jelszó:
MAIL_FROM=no-reply@cinegrade.local
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
# Dockerben futó backend ezt használja a MAIL_HOST helyett (konténerben a Mailpit neve "mailpit")
MAIL_HOST_IN_DOCKER=mailpit
#
# Prod: Gmail (alkalmazásjelszó: https://myaccount.google.com/apppasswords)
#   MAIL_FROM=<gmail cím>
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587                  (587 = STARTTLS; a 465 más titkosítási mód, azzal nem működik)
#   MAIL_USERNAME=<gmail cím>
#   MAIL_PASSWORD=<16 karakter, SZÓKÖZÖK NÉLKÜL>
#   MAIL_SMTP_AUTH=true
#   MAIL_STARTTLS=true
#   MAIL_HOST_IN_DOCKER=smtp.gmail.com

# --- Frontend cím (aktivációs e-mail linkje + CORS) ---
# Dev (npm start): http://localhost:4200
# Teljes docker stack a gépen: http://localhost:8000
# Éles domain: https://cinegrade.duckdns.org
FRONTEND_URL=http://localhost:4200
CORS_ALLOWED_ORIGINS=http://localhost:4200
